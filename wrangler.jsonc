{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masoud-1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "027d93ca-483c-4b4b-b9a6-afe972582e30","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "69be3762699b430ea7d4f84c2e23fd41" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
